# ============================================================
# Git Ignore File for DocuMind AI
# Files listed here will NOT be uploaded to GitHub
# ============================================================

# --- Secret Configuration (NEVER commit this!) ---
.env

# --- Python Virtual Environment ---
venv/
env/
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
*.pdb

# --- Uploaded PDF Files (user data – not part of source code) ---
uploads/
temp_uploads/

# --- Model Cache (large files downloaded automatically) ---
models/
.cache/

# --- Test and Build Artifacts ---
.pytest_cache/
*.egg-info/
dist/
build/
htmlcov/
.coverage

# --- IDE Files ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# --- Windows System Files ---
Thumbs.db
desktop.ini
