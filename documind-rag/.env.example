# ============================================================
# DocuMind AI – Environment Configuration Example
# ============================================================
# 1. Copy this file and rename it to ".env"
# 2. Fill in your real values below
# 3. NEVER share your .env file or commit it to Git
# ============================================================

# --- LLM Provider Configuration ---
# Which API to use for generating answers.
# Supported options:
#   "openai"     – Use OpenAI's API (needs a paid or free-tier API key)
#   "openrouter" – Use OpenRouter (gives access to many models, including free ones)
#   "none"       – Disable AI answer generation; only show retrieved document chunks
LLM_PROVIDER=openrouter

# Your API key for the selected provider.
# Get a free OpenRouter key at: https://openrouter.ai  (no credit card needed for free models)
# Get an OpenAI key at: https://platform.openai.com/api-keys
LLM_API_KEY=your_api_key_here

# The AI model to use for generating answers.
# For OpenRouter (free models):
#   "google/gemma-3-27b-it:free"
#   "meta-llama/llama-3.1-8b-instruct:free"
#   "mistralai/mistral-7b-instruct:free"
# For OpenAI:
#   "gpt-4o-mini"  (cheapest)
#   "gpt-3.5-turbo"
LLM_MODEL=google/gemma-3-27b-it:free

# --- Embedding Model (runs locally on your laptop, no API key needed) ---
# This model converts text into numbers for semantic search.
# all-MiniLM-L6-v2 is small, fast, and accurate – perfect for a laptop.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Text Chunking Settings ---
# How many characters each text chunk should contain.
# Smaller = more precise retrieval; Larger = more context per chunk.
CHUNK_SIZE=500

# How many characters overlap between consecutive chunks.
# Overlap helps avoid splitting important sentences at boundaries.
CHUNK_OVERLAP=100

# --- Retrieval Settings ---
# How many document chunks to retrieve for each question.
TOP_K_RESULTS=5

# Minimum similarity score (0.0 to 1.0) to consider a chunk relevant.
# Lower = more permissive; Higher = stricter.
SIMILARITY_THRESHOLD=0.3

# --- Upload Settings ---
# Maximum allowed PDF file size in megabytes.
MAX_UPLOAD_SIZE_MB=50
